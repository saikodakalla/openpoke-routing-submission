# Backend only. Copy to .env and add your own key. Never use NEXT_PUBLIC_ for keys.
OPENROUTER_API_KEY=
OPENPOKE_CHAT_MODEL=openai/gpt-4o-mini
OPENPOKE_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENPOKE_EMBEDDING_DIM=1536
OPENPOKE_PROVIDER_TIMEOUT=25
# Live calls reserve a persistent cumulative budget before every HTTP attempt.
OPENPOKE_MAX_CALLS=100
OPENPOKE_MAX_TOKENS=200000
OPENPOKE_MAX_COST_USD=1.00
OPENPOKE_INPUT_USD_PER_M=5
OPENPOKE_OUTPUT_USD_PER_M=20
OPENPOKE_EMBED_USD_PER_M=1
